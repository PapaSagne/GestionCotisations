@model GestionCotisations.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Tableau de bord";
}

<!-- Cartes statistiques -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Membres actifs</p>
                        <h3 class="fw-bold mb-0">@Model.MembresActifs</h3>
                        <small class="text-muted">sur @Model.TotalMembres total</small>
                    </div>
                    <div class="icon-box bg-primary bg-opacity-10 text-primary">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Montant encaissé</p>
                        <h3 class="fw-bold mb-0">@Model.TotalMontantEncaisse.ToString("N0")</h3>
                        <small class="text-muted">FCFA</small>
                    </div>
                    <div class="icon-box bg-success bg-opacity-10 text-success">
                        <i class="fas fa-money-bill-wave fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Taux de recouvrement</p>
                        <h3 class="fw-bold mb-0">@Model.TauxRecouvrement%</h3>
                        <div class="progress mt-1" style="height:6px; width:100px;">
                            <div class="progress-bar bg-success"
                                 style="width:@Model.TauxRecouvrement%"></div>
                        </div>
                    </div>
                    <div class="icon-box bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-chart-pie fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted small mb-1">Cotisations en retard</p>
                        <h3 class="fw-bold mb-0 text-danger">@Model.CotisationsEnRetard</h3>
                        <small class="text-muted">@Model.CotisationsPayees payées</small>
                    </div>
                    <div class="icon-box bg-danger bg-opacity-10 text-danger">
                        <i class="fas fa-exclamation-triangle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Graphique + Cotisations en retard -->
<div class="row g-4 mb-4">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-chart-bar me-2 text-primary"></i>
                    Paiements des 6 derniers mois
                </h6>
            </div>
            <div class="card-body">
                <canvas id="chartPaiements" height="100"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-chart-doughnut me-2 text-success"></i>
                    Statut des cotisations
                </h6>
            </div>
            <div class="card-body d-flex flex-column align-items-center">
                <canvas id="chartStatuts" height="180"></canvas>
                <div class="mt-3 w-100">
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="fas fa-circle text-success me-1"></i> Payées</span>
                        <strong>@Model.CotisationsPayees</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span><i class="fas fa-circle text-warning me-1"></i> En attente</span>
                        <strong>@Model.CotisationsEnAttente</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span><i class="fas fa-circle text-danger me-1"></i> En retard</span>
                        <strong>@Model.CotisationsEnRetard</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-history me-2 text-primary"></i> Derniers paiements
                </h6>
                <a asp-controller="Paiements" asp-action="Index" class="btn btn-outline-primary btn-sm">
                    Voir tout
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.DerniersPaiements.Any())
                {
                    <p class="text-muted text-center py-4">Aucun paiement</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <tbody>
                            @foreach (var p in Model.DerniersPaiements)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@p.MembreNom</div>
                                        <small class="text-muted">@p.Libelle</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-success">@p.Montant.ToString("N0") F</div>
                                        <small class="text-muted">@p.Date.ToString("dd/MM/yyyy")</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-exclamation-circle me-2 text-danger"></i> Cotisations en retard
                </h6>
                <a asp-controller="Cotisations" asp-action="Index"
                   asp-route-statut="EnRetard" class="btn btn-outline-danger btn-sm">
                    Voir tout
                </a>
            </div>
            <div class="card-body p-0">
                @if (!Model.CotisationsRetard.Any())
                {
                    <p class="text-success text-center py-4">
                        <i class="fas fa-check-circle me-2"></i> Aucun retard !
                    </p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <tbody>
                            @foreach (var c in Model.CotisationsRetard)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@c.MembreNom</div>
                                        <small class="text-muted">@c.Libelle</small>
                                    </td>
                                    <td class="text-end">
                                        <div class="fw-bold text-danger">@c.Montant.ToString("N0") F</div>
                                        <small class="text-danger">@c.JoursRetard jours de retard</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Graphique barres 
        const ctx1 = document.getElementById('chartPaiements').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MoisLabels)),
                datasets: [{
                    label: 'Paiements (FCFA)',
                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MoisMontants)),
                    backgroundColor: 'rgba(45, 106, 159, 0.7)',
                    borderColor: 'rgba(45, 106, 159, 1)',
                    borderWidth: 2,
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { callback: v => v.toLocaleString() + ' F' } }
                }
            }
        });

        // Graphique donut 
        const ctx2 = document.getElementById('chartStatuts').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['Payées', 'En attente', 'En retard'],
                datasets: [{
                    data: [@Model.CotisationsPayees, @Model.CotisationsEnAttente, @Model.CotisationsEnRetard],
                    backgroundColor: ['#28a745', '#ffc107', '#dc3545'],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                cutout: '70%'
            }
        });
    </script>
}

@section Styles {
    <style>
        .icon-box {
            width: 60px;
            height: 60px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}