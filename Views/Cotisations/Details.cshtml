@model GestionCotisations.Web.Models.Cotisation
@using GestionCotisations.Web.Models

@{
    ViewData["Title"] = "Détails de la Cotisation";
    var montantPaye = Model.Paiements.Sum(p => p.Montant);
    var resteAPayer = Model.Montant - montantPaye;
    var pourcentage = Model.Montant > 0 ? (int)((montantPaye / Model.Montant) * 100) : 0;
}

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm p-4">
            <h6 class="fw-bold mb-3">
                <i class="fas fa-info-circle me-2 text-primary"></i> Informations
            </h6>
            <p><strong>Membre :</strong> @Model.Membre?.Prenom @Model.Membre?.Nom</p>
            <p><strong>Libellé :</strong> @Model.Libelle</p>
            <p><strong>Montant total :</strong> @Model.Montant.ToString("N0") FCFA</p>
            <p><strong>Début :</strong> @Model.DateDebut.ToString("dd/MM/yyyy")</p>
            <p><strong>Fin :</strong> @Model.DateFin.ToString("dd/MM/yyyy")</p>
            <p><strong>Échéance :</strong> @Model.DateEcheance.ToString("dd/MM/yyyy")</p>
            <p>
                <strong>Statut :</strong>
                @{
                    var badgeClass = Model.Statut switch
                    {
                        StatutCotisation.Payee => "success",
                        StatutCotisation.EnRetard => "danger",
                        StatutCotisation.Annulee => "secondary",
                        _ => "warning"
                    };
                }
                <span class="badge bg-@badgeClass">@Model.Statut</span>
            </p>

            <hr />
            <h6 class="fw-bold">Progression du paiement</h6>
            <div class="progress mb-2" style="height: 20px;">
                <div class="progress-bar bg-success" style="width: @pourcentage%">@pourcentage%</div>
            </div>
            <p class="text-success"><strong>Payé :</strong> @montantPaye.ToString("N0") FCFA</p>
            <p class="text-danger"><strong>Reste :</strong> @resteAPayer.ToString("N0") FCFA</p>

            <div class="d-flex gap-2 mt-3">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm flex-fill">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-money-bill-wave me-2 text-success"></i>
                    Paiements (@Model.Paiements.Count)
                </h6>
                <a asp-controller="Paiements" asp-action="Create"
                   asp-route-cotisationId="@Model.Id" class="btn btn-success btn-sm">
                    <i class="fas fa-plus me-1"></i> Ajouter un paiement
                </a>
            </div>
            <div class="card-body">
                @if (!Model.Paiements.Any())
                {
                    <p class="text-muted text-center py-3">Aucun paiement enregistré</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Montant</th>
                                <th>Mode</th>
                                <th>Référence</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.Paiements)
                            {
                                <tr>
                                    <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                                    <td class="fw-bold text-success">@p.Montant.ToString("N0") FCFA</td>
                                    <td>@p.Mode</td>
                                    <td>@p.Reference</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>