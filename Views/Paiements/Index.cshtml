@model IEnumerable<GestionCotisations.Web.Models.Paiement>

@{
    ViewData["Title"] = "Gestion des Paiements";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">
            <i class="fas fa-money-bill-wave me-2 text-warning"></i> Liste des Paiements
        </h5>
        <a asp-action="Create" class="btn btn-warning btn-sm">
            <i class="fas fa-plus me-1"></i> Nouveau paiement
        </a>
    </div>

    <div class="card-body">
        <!-- Recherche -->
        <form method="get" class="mb-3">
            <div class="input-group" style="max-width: 400px;">
                <input type="text" name="search" value="@ViewData["Search"]"
                       class="form-control" placeholder="Rechercher..." />
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-search"></i>
                </button>
                @if (!string.IsNullOrEmpty(ViewData["Search"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times"></i>
                    </a>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Membre</th>
                        <th>Cotisation</th>
                        <th>Montant</th>
                        <th>Date</th>
                        <th>Mode</th>
                        <th>Référence</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Aucun paiement trouvé
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td class="fw-semibold">
                                @p.Cotisation?.Membre?.Prenom @p.Cotisation?.Membre?.Nom
                            </td>
                            <td>@p.Cotisation?.Libelle</td>
                            <td class="fw-bold text-success">@p.Montant.ToString("N0") FCFA</td>
                            <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-info text-dark">@p.Mode</span>
                            </td>
                            <td>@p.Reference</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@p.Id"
                                       class="btn btn-outline-warning" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Delete" asp-route-id="@p.Id"
                                              method="post" style="display:inline"
                                              onsubmit="return confirm('Supprimer ce paiement ?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Total -->
        @if (Model.Any())
        {
            <div class="text-end mt-2">
                <strong class="text-success fs-5">
                    Total : @Model.Sum(p => p.Montant).ToString("N0") FCFA
                </strong>
            </div>
        }
    </div>
</div>