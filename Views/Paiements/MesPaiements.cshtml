@model IEnumerable<GestionCotisations.Web.Models.Paiement>

@{
    ViewData["Title"] = "Mes Paiements";
}

@if (ViewBag.Message != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Message
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-bold">
            <i class="fas fa-money-bill-wave me-2 text-warning"></i> Mes Paiements
        </h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Cotisation</th>
                        <th>Montant payé</th>
                        <th>Date</th>
                        <th>Mode</th>
                        <th>Référence</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Aucun paiement trouvé
                            </td>
                        </tr>
                    }
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.Cotisation?.Libelle</td>
                            <td class="fw-bold text-success">@p.Montant.ToString("N0") FCFA</td>
                            <td>@p.DatePaiement.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-info text-dark">@p.Mode</span></td>
                            <td>@p.Reference</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Any())
        {
            <div class="text-end mt-2">
                <strong class="text-success fs-5">
                    Total payé : @Model.Sum(p => p.Montant).ToString("N0") FCFA
                </strong>
            </div>
        }
    </div>
</div>