@{
    ViewData["Title"] = "Erreur";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>Erreur — Gestion Cotisations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        body {
            background: linear-gradient(135deg, #6b1e1e, #9f2d2d);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
        }
        .error-box {
            text-align: center;
            padding: 60px 40px;
            background: rgba(255,255,255,0.1);
            border-radius: 20px;
            backdrop-filter: blur(10px);
        }
    </style>
</head>
<body>
    <div class="error-box">
        <i class="fas fa-exclamation-triangle fa-5x mb-4 opacity-75"></i>
        <h2>Une erreur est survenue</h2>
        <p class="opacity-75 mb-4">
            Quelque chose s'est mal passé. Veuillez réessayer ou contacter l'administrateur.
        </p>
        <a href="/" class="btn btn-light btn-lg">
            <i class="fas fa-home me-2"></i> Retour à l'accueil
        </a>
    </div>
</body>
</html>