@model GestionCotisations.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Connexion";
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — Gestion Cotisations</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            background: #0a0a0a;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Arial, sans-serif;
            overflow: hidden;
        }

        .bg-animated {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: radial-gradient(ellipse at 20% 50%, #1a1200 0%, #0a0a0a 60%),
                        radial-gradient(ellipse at 80% 20%, #1a1000 0%, transparent 60%);
            z-index: 0;
        }

        .bg-animated::before {
            content: '';
            position: absolute;
            top: -50%; left: -50%;
            width: 200%; height: 200%;
            background: repeating-linear-gradient(
                45deg,
                transparent,
                transparent 40px,
                rgba(212, 175, 55, 0.015) 40px,
                rgba(212, 175, 55, 0.015) 41px
            );
            animation: bgMove 20s linear infinite;
        }

        @@keyframes bgMove {
            0% { transform: translate(0, 0); }
            100% { transform: translate(50px, 50px); }
        }

        .circle-deco {
            position: fixed;
            border-radius: 50%;
            border: 1px solid rgba(212, 175, 55, 0.1);
            animation: pulse 4s ease-in-out infinite;
        }
        .circle-1 { width: 400px; height: 400px; top: -100px; right: -100px; animation-delay: 0s; }
        .circle-2 { width: 300px; height: 300px; top: -50px; right: -50px; animation-delay: 0.5s; }
        .circle-3 { width: 600px; height: 600px; bottom: -200px; left: -200px; animation-delay: 1s; border-color: rgba(212,175,55,0.05); }

        @@keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.05); opacity: 1; }
        }

        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 460px;
            padding: 20px;
        }

        .login-card {
            background: linear-gradient(145deg, #141414, #1a1a1a);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 20px;
            padding: 50px 45px;
            box-shadow:
                0 0 60px rgba(212, 175, 55, 0.08),
                0 30px 60px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(212, 175, 55, 0.1);
            backdrop-filter: blur(20px);
        }

        /* Logo */
        .login-logo {
            text-align: center;
            margin-bottom: 40px;
        }

        .logo-icon {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #D4AF37, #F5D76E, #B8860B);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            box-shadow: 0 0 30px rgba(212, 175, 55, 0.4), 0 0 60px rgba(212, 175, 55, 0.1);
            animation: glow 3s ease-in-out infinite;
        }

        @@keyframes glow {
            0%, 100% { box-shadow: 0 0 30px rgba(212, 175, 55, 0.4), 0 0 60px rgba(212, 175, 55, 0.1); }
            50% { box-shadow: 0 0 40px rgba(212, 175, 55, 0.7), 0 0 80px rgba(212, 175, 55, 0.2); }
        }

        .logo-icon i { font-size: 32px; color: #0a0a0a; }

        .login-logo h4 {
            color: #D4AF37;
            font-weight: 700;
            font-size: 22px;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .login-logo p {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
        }

        .gold-divider {
            height: 1px;
            background: linear-gradient(90deg, transparent, #D4AF37, transparent);
            margin: 0 auto 35px;
            width: 80%;
            opacity: 0.5;
        }

        .form-label {
            color: rgba(212, 175, 55, 0.8);
            font-size: 13px;
            font-weight: 600;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .input-group-custom {
            position: relative;
            margin-bottom: 20px;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(212, 175, 55, 0.5);
            font-size: 14px;
            z-index: 5;
        }

        .form-control-custom {
            width: 100%;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(212, 175, 55, 0.2);
            border-radius: 10px;
            padding: 14px 16px 14px 44px;
            color: #ffffff;
            font-size: 14px;
            transition: all 0.3s;
            outline: none;
        }

        .form-control-custom::placeholder { color: rgba(255,255,255,0.2); }

        .form-control-custom:focus {
            border-color: #D4AF37;
            background: rgba(212, 175, 55, 0.05);
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
            color: #ffffff;
        }

        .remember-row {
            display: flex;
            align-items: center;
            margin-bottom: 28px;
        }

        .custom-check {
            width: 18px; height: 18px;
            accent-color: #D4AF37;
            cursor: pointer;
            margin-right: 8px;
        }

        .remember-label {
            color: rgba(255,255,255,0.4);
            font-size: 13px;
            cursor: pointer;
        }

        .btn-gold {
            width: 100%;
            padding: 15px;
            background: linear-gradient(135deg, #D4AF37, #F5D76E, #B8860B);
            border: none;
            border-radius: 10px;
            color: #0a0a0a;
            font-weight: 700;
            font-size: 15px;
            letter-spacing: 1px;
            cursor: pointer;
            transition: all 0.3s;
            text-transform: uppercase;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.3);
            position: relative;
            overflow: hidden;
        }

        .btn-gold::before {
            content: '';
            position: absolute;
            top: 0; left: -100%;
            width: 100%; height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .btn-gold:hover::before { left: 100%; }

        .btn-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(212, 175, 55, 0.5);
        }

        .btn-gold:active { transform: translateY(0); }

        /* Alerte */
        .alert-custom {
            background: rgba(220, 53, 69, 0.1);
            border: 1px solid rgba(220, 53, 69, 0.3);
            border-radius: 10px;
            padding: 12px 16px;
            color: #ff6b6b;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .login-footer {
            text-align: center;
            margin-top: 30px;
            color: rgba(255,255,255,0.2);
            font-size: 11px;
            letter-spacing: 1px;
        }

        .login-footer span { color: rgba(212, 175, 55, 0.4); }
    </style>
</head>
<body>

<div class="bg-animated"></div>
<div class="circle-deco circle-1"></div>
<div class="circle-deco circle-2"></div>
<div class="circle-deco circle-3"></div>

<div class="login-wrapper">
    <div class="login-card">

        <div class="login-logo">
            <div class="logo-icon">
                <i class="fas fa-coins"></i>
            </div>
            <h4>GESTION COTISATIONS</h4>
            <p>Connectez-vous à votre espace sécurisé</p>
        </div>

        <div class="gold-divider"></div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-custom">
                <i class="fas fa-exclamation-circle me-2"></i>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <span>@error.ErrorMessage</span>
                }
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-1">
                <label class="form-label">
                    <i class="fas fa-envelope me-1"></i> ADRESSE EMAIL
                </label>
            </div>
            <div class="input-group-custom">
                <i class="fas fa-envelope input-icon"></i>
                <input asp-for="Email" class="form-control-custom" placeholder="votre@email.com" autocomplete="email" />
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>

            <div class="mb-1 mt-2">
                <label class="form-label">
                    <i class="fas fa-lock me-1"></i> MOT DE PASSE
                </label>
            </div>
            <div class="input-group-custom">
                <i class="fas fa-lock input-icon"></i>
                <input asp-for="Password" class="form-control-custom" placeholder="••••••••" autocomplete="current-password" />
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>

            <div class="remember-row mt-3">
                <input asp-for="RememberMe" type="checkbox" class="custom-check" id="rememberMe" />
                <label for="rememberMe" class="remember-label">Se souvenir de moi</label>
            </div>

            <button type="submit" class="btn-gold">
                <i class="fas fa-sign-in-alt me-2"></i> SE CONNECTER
            </button>
        </form>

        <div class="login-footer">
            <span>⬡</span> GESTION COTISATIONS &nbsp;·&nbsp; VERSION 1.0 <span>⬡</span>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>