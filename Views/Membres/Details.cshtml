@model GestionCotisations.Web.Models.Membre

@{
    ViewData["Title"] = "Détails du Membre";
}

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center p-4">
            <div class="avatar-circle-lg mx-auto mb-3">
                @Model.Prenom[0]@Model.Nom[0]
            </div>
            <h5 class="fw-bold">@Model.Prenom @Model.Nom</h5>
            <p class="text-muted">@Model.Email</p>
            @if (Model.EstActif)
            {
                <span class="badge bg-success">Actif</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactif</span>
            }
            <hr />
            <div class="text-start">
                <p><i class="fas fa-phone me-2 text-primary"></i> @Model.Telephone</p>
                <p><i class="fas fa-map-marker-alt me-2 text-primary"></i> @Model.Adresse</p>
                <p><i class="fas fa-calendar me-2 text-primary"></i> Inscrit le @Model.DateInscription.ToString("dd/MM/yyyy")</p>
            </div>
            <div class="d-flex gap-2 mt-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm flex-fill">
                    <i class="fas fa-edit me-1"></i> Modifier
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm flex-fill">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="fw-bold mb-0">
                    <i class="fas fa-file-invoice-dollar me-2 text-success"></i>
                    Cotisations (@Model.Cotisations.Count)
                </h6>
            </div>
            <div class="card-body">
                @if (!Model.Cotisations.Any())
                {
                    <p class="text-muted text-center py-3">Aucune cotisation pour ce membre</p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead class="table-light">
                            <tr>
                                <th>Libellé</th>
                                <th>Montant</th>
                                <th>Échéance</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cotisation in Model.Cotisations)
                            {
                                <tr>
                                    <td>@cotisation.Libelle</td>
                                    <td>@cotisation.Montant.ToString("N0") FCFA</td>
                                    <td>@cotisation.DateEcheance.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge bg-@(cotisation.Statut == GestionCotisations.Web.Models.StatutCotisation.Payee ? "success" : cotisation.Statut == GestionCotisations.Web.Models.StatutCotisation.EnRetard ? "danger" : "warning")">
                                            @cotisation.Statut
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle-lg {
            width: 80px; height: 80px;
            background: linear-gradient(135deg, #1e3a5f, #2d6a9f);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            font-weight: 700;
        }
    </style>
}